{
  "attribution": { "commit": "", "pr": "" },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/list-merged-branches.sh",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready)",
      "Bash(gh pr ready *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh repo edit *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(*.local)",
      "Read(secrets/**)",
      "Read(private/**)"
    ]
  }
}
